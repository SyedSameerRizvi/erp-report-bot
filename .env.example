# Copy to .env.local and fill in. Without GROQ_API_KEY the app runs in mock mode ($0, canned answers).
GROQ_API_KEY=
# Optional overrides (defaults shown)
GROQ_MODEL_BIG=openai/gpt-oss-120b
GROQ_MODEL_SMALL=openai/gpt-oss-20b
# Force mock mode even with a key: MOCK_LLM=1
MOCK_LLM=
# Real Postgres (e.g. Supabase connection string). Empty = local in-process PGlite in ./.pglite
DATABASE_URL=
# Supabase Auth (email + password). Both empty = login off, local demo user (dev only; production refuses to start without them).
# Supabase dashboard -> Project Settings -> API: Project URL and a publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# New (non-cached) questions allowed per user per hour
ASK_HOURLY_QUOTA=60
